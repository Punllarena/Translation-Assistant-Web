{$TA_SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Uploads are capped again in the API (10 MiB images, 5 MiB text, 64 MiB EPUB) after the body
	# is received; this stops a larger body before it reaches uvicorn at all.
	# EPUB uploads may be up to 64 MiB (plan ruling 3); everything else stays at 12 MB.
	@epub path /api/epub/*
	request_body @epub {
		max_size 64MiB
	}
	@not_epub not path /api/epub/*
	request_body @not_epub {
		max_size 12MB
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle /assets/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		# index.html is served for /, /index.html and every client route (the try_files
		# fallback); the header matcher runs before the rewrite, so apply it to the whole
		# handle. Hashed files live under /assets and are handled above.
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
