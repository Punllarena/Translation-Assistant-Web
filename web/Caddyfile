{$TA_SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Uploads are capped again in the API after the body is received; these stop a larger
	# body before it reaches uvicorn. EPUB and dictionary files: 64 MiB. A desktop ta.db:
	# 1 GiB (spec §6.5). A whole-server restore: 4 GiB, one streamed request. Everything else: 12 MB.
	@big path /api/epub/* /api/admin/dictionary/*
	request_body @big {
		max_size 64MiB
	}
	@tadb path /api/import/tadb
	request_body @tadb {
		max_size 1GiB
	}
	@restore path /api/admin/restore /api/setup/restore
	request_body @restore {
		max_size 4GiB
	}
	@small not path /api/epub/* /api/admin/dictionary/* /api/import/tadb /api/admin/restore /api/setup/restore
	request_body @small {
		max_size 12MB
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle /assets/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		# index.html is served for /, /index.html and every client route (the try_files
		# fallback); the header matcher runs before the rewrite, so apply it to the whole
		# handle. Hashed files live under /assets and are handled above.
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
