TA_SECRET_KEY=change-me-to-at-least-32-characters-long
TA_DATABASE_URL=postgresql+psycopg://ta:ta@localhost:5432/ta
TA_ALLOW_PUBLIC_SIGNUP=false
TA_COOKIE_SECURE=false
# Machine translation (server defaults; per-user credentials override the URLs)
TA_OLLAMA_URL=http://localhost:11434
TA_LIBRETRANSLATE_URL=
TA_EDICT_PATH=
TA_CONJUGATIONS_PATH=
# true lets user-supplied LibreTranslate/Ollama URLs point at private or loopback addresses
TA_MT_ALLOW_PRIVATE_URLS=false
# Background jobs and syosetu fetching
TA_RUN_JOBS_WORKER=true
TA_SYOSETU_DELAY_SECONDS=5
